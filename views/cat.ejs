<%- include("templates/header") %> 
<div class="max-w-md mx-auto bg-panel/80 border border-white/10 rounded-xl p-6 shadow-lg shadow-black/40 text-center">
    <%  if (cat == 1) { %> 
        <h1 class="font-display text-xl text-parchment mb-4">Fluffy</h1>
        <img class="mx-auto rounded-lg" src='/fluffy.gif' style='width:250px;'>
    <% } else if (cat == 2) { %>
        <h1 class="font-display text-xl text-parchment mb-4">Socks</h1>
        <img class="mx-auto rounded-lg" src='/socks.gif' style='width:250px;'>
    <% } else { %>
        <p class="text-mist">Invalid cat id: <%= cat %></p>
    <% } %>  
</div>
<%- include("templates/footer") %>
