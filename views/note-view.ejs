<%- include("templates/header") %> 
<div class="max-w-3xl mx-auto">
    <a href="/notes" class="text-mist hover:text-parchment text-sm transition-colors">&larr; All Notes</a>

    <article class="mt-4 bg-panel/70 border border-white/10 rounded-xl p-6 sm:p-8 shadow-lg shadow-black/40">
        <div class="flex items-start justify-between gap-4 border-b border-white/10 pb-4 mb-6">
            <div>
                <h1 class="font-display text-3xl text-parchment leading-tight"><%= note.title %></h1>
                <% if (note.folder) { %>
                    <div class="text-xs uppercase tracking-widest text-gilt/80 mt-2"><%= note.folder %></div>
                <% } %>
            </div>
            <% if (authenticated) { %>
                <a href="/notes/edit/<%= note.note_id %>" class="shrink-0 px-4 py-2 rounded-md border border-white/15 text-mist hover:text-parchment hover:bg-white/5 transition-colors">Edit</a>
            <% } %>
        </div>
        <div class="note-content">
            <%- html %>
        </div>
    </article>
</div>
<%- include("templates/footer") %>
