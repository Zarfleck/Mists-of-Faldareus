<%- include("templates/header") %> 
<div class="max-w-3xl mx-auto p-4">
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-bold">Campaign Notes</h1>
        <% if (authenticated) { %>
            <a href="/notes/new" class="p-2 bg-green-200 border border-black rounded-md shadow-md shadow-black">+ New Note</a>
        <% } %>
    </div>

    <% var folders = Object.keys(grouped).sort(); %>
    <% if (folders.length === 0) { %>
        <p class="text-gray-600">No notes yet.</p>
    <% } %>
    <% folders.forEach(function(folder) { %>
        <div class="mb-6">
            <h2 class="text-lg font-semibold border-b border-gray-400 mb-2"><%= folder %></h2>
            <ul class="list-disc ml-6">
                <% grouped[folder].forEach(function(note) { %>
                    <li><a class="text-blue-700 underline" href="/notes/view/<%= note.note_id %>"><%= note.title %></a></li>
                <% }); %>
            </ul>
        </div>
    <% }); %>
</div>
<%- include("templates/footer") %>
