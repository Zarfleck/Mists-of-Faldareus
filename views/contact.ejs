<%- include("templates/header") %> 
<div class="max-w-md mx-auto bg-panel/80 border border-white/10 rounded-xl p-6 sm:p-8 shadow-lg shadow-black/40">
    <h1 class="font-display text-2xl text-parchment mb-6">Contact</h1>
    <form action="/submitEmail" method="post" class="flex flex-col gap-4">
        <label class="flex flex-col gap-1">
            <span class="text-sm text-mist">Email address</span>
            <input class="w-full bg-ink/60 border border-white/15 rounded-md px-3 py-2 text-parchment placeholder-mist/40 focus:outline-none focus:border-gilt" type="email" name="email" placeholder="you@example.com" />
        </label>
        <button class="px-4 py-2 rounded-md bg-blood hover:bg-bloodhover text-parchment font-display tracking-wide transition-colors" type="submit">Subscribe</button>
    </form>
    <% if (missing) { %>
        <p class="mt-4 text-sm text-blood">Email is required.</p>
    <% } %>
</div>
<%- include("templates/footer") %>
