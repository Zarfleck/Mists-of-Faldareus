<%- include("templates/header") %> 
<div class="max-w-3xl mx-auto p-4">
    <div class="mb-4">
        <a href="/notes" class="text-blue-700 underline">&larr; All Notes</a>
    </div>
    <h1 class="text-2xl font-bold mb-4"><%= heading %></h1>
    <form action="<%= action %>" method="post" class="flex flex-col gap-3">
        <label class="flex flex-col">
            <span class="font-semibold">Title</span>
            <input class="border-2 p-1" type="text" name="title" value="<%= note.title %>" required>
        </label>
        <label class="flex flex-col">
            <span class="font-semibold">Folder</span>
            <input class="border-2 p-1" type="text" name="folder" value="<%= note.folder %>" placeholder="e.g. NPCs/Strangers">
        </label>
        <label class="flex flex-col">
            <span class="font-semibold">Content (Markdown)</span>
            <textarea class="border-2 p-1 font-mono" name="content" rows="20"><%= note.content %></textarea>
        </label>
        <div>
            <button class="p-2 bg-green-200 border border-black rounded-md shadow-md shadow-black" type="submit">Save</button>
        </div>
    </form>
</div>
<%- include("templates/footer") %>
